# Telegram Bot Token (отримай від BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Ключ шифрування токена Monobank (згенеруй довільний випадковий секрет)
MONOBANK_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Окремий ключ резервних копій; збережіть його поза сервером і не змінюйте
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-characters

# ID адміністратора Telegram
ADMIN_TELEGRAM_ID=YOUR_ADMIN_ID_HERE

# Шлях до бази даних
DATABASE_PATH=fitness_bot.sqlite3

# Рівень логування (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
